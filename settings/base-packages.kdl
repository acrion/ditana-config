// Non-configurable settings that define the installation of packages determined by
// default values, which are derived from the installation logic.
- name="intel-microcode" default-value="`intel-cpu`" {
    arch-packages "intel-ucode"
  }

- name="amd-microcode" default-value="`amd-cpu`" {
    arch-packages "amd-ucode"
  }

- name="firmware" default-value=#true {
    // should match those packages of `packages.x86_64` that install into `/usr/lib/firmware`, with the exception of amd-ucode, intel-ucode and b43-firmware
    arch-packages "linux-atm" \
                  "linux-firmware" \
                  "linux-firmware-marvell" \
                  "sof-firmware" \
                  "wireless-regdb"
  }

- name="b43-firmware" default-value="`b43-required`" {
    // we separate this from the rest of the firmware packages and install it only if it is required, because it requires a specific kernel
    arch-packages "b43-firmware"
  }

- name="install-syslinux" default-value="`zfs-filesystem AND NOT uefi`" {
    arch-packages "syslinux"
  }

- name="install-grub" default-value="`NOT zfs-filesystem`" {
    arch-packages "grub"
  }

- name="install-efibootmgr" default-value="`uefi`" {
    arch-packages "efibootmgr"
  }

- name="ditana-base" default-value=#true {
    arch-packages "base" \              // Minimal package set to define a basic Arch Linux installation.
                  "base-devel" \        // Provides various essential tools like sudo. Optional dependency of pacman, required to use makepkg.
                  "dialog" \            // Utilized in chroot-install.sh to prompt for the user password.
                  "bash" \              // Required for chroot-install.sh.
                  "ditana-filesystem" \ // Base Ditana GNU/Linux files, based on the original 'filesystem' package from Arch Linux.
                  "glibc-locales" \     // Required for localized output and locale-dependent functions in various applications (even for users who choose en_US.UTF-8 for LC_MESSAGES).
                  "libpwquality" \      // Provides pwscore which we use in chroot-install.sh to validate user passwort quality
                  "lsb-release" \       // Provides the lsb_release command, as referenced at https://refspecs.linuxfoundation.org/lsb.shtml.
                  "mkinitcpio" \        // Provides initramfs (alternatives: dracut, booster)
                  "os-prober" \         // See https://wiki.archlinux.org/title/GRUB/Detecting_other_operating_systems
                  "paru" \              // Ditana’s chosen AUR helper
                  "rakudo-bin" \        // Used in chroot-install.sh to safely customize grub und mkinitcpio configuration files.
                  "terminus-font" \     // The terminal font that will be configured.
                  "util-linux" \        // Provides various essential tools, among others it is required to enable the fstrim.timer, depending on value of enable-fstrim
                  "ditana-keyring"      // Provides keyring update for the Ditana Arch repo
    files "/var/log/install_ditana.log" \ // This copies the installation log inside the chroot environment, where logging of the chroot steps will continue.
          "/etc/lsb-release" \
          "/etc/systemd/system/ditana-initialize-system.service" \
          "/etc/profile.d/ditana-java.sh" \
          "/etc/profile.d/ditana-system-paths.sh" \
          "/etc/profile.d/ditana-bash-setup.sh" \
          "/usr/lib/ditana/create-debug-user" \
          "/etc/skel/.bashrc_ditana" \
          "/etc/skel/.shellrc" \
          "/etc/skel/.shell.d/readme.md" \
          "/usr/share/pixmaps/ditana-logo.png" \
          "/usr/share/pixmaps/ditana-logo.svg" \
          "/etc/systemd/system/ditana_kbdrate.service" \
          \ // Install the custom sudoers configuration to preserve the EDITOR and VISUAL environment variables in the sudo context,
          \ // ensuring that the default editor is used even when elevated permissions are required.
          "/etc/sudoers.d/10-ditana-editor"
    chroot-script "mkdir -p /etc/environment.d" \
                  "echo COLORTERM=truecolor >>/etc/environment.d/ditana-set-colorterm.conf" \
                  #"echo DEBUGINFOD_URLS="https://debuginfod.archlinux.org" >>/etc/environment.d/ditana-set-arch-debuginfo.conf"# \
                  #"sed -i 's|@@KEYBOARD_DELAY@@|'"$KEYBOARD_DELAY"'|' /etc/systemd/system/ditana_kbdrate.service"# \
                  #"sed -i 's|@@KEYBOARD_RATE@@|'"$KEYBOARD_RATE"'|' /etc/systemd/system/ditana_kbdrate.service"# \
                  "systemctl enable ditana_kbdrate.service"
  }

- name="block-localsearch" default-value=#true {
    // localsearch, GNOME's file indexing service (formerly known as Tracker),
    // must never be executed on Ditana, regardless of which package provides it
    // or any subsequent update. nautilus depends on it strictly, as do
    // gnome-music and gnome-photos. It must remain installed nonetheless, since
    // nautilus aborts without its GSettings schema, so NoExtract blocks only
    // the files it starts from: its D-Bus services, its systemd user units, and
    // its autostart entry. validate-logic.py verifies against the repositories
    // that these patterns cover every such file, that none of them matches any
    // other file of localsearch, and that each pattern matches files from
    // exactly one package.
    //
    // Like every setting that enters NoExtract patterns, it ships the helper
    // it calls for that purpose itself.
    files "/usr/lib/ditana/no-extract"
    chroot-script #"/usr/lib/ditana/no-extract "Ditana never runs localsearch, GNOME's file indexer: the NoExtract lines that follow keep pacman from extracting its D-Bus services, user units and autostart entry. To allow it, remove this comment and those lines, then run 'pacman -S localsearch', which extracts these files again." 'etc/xdg/autostart/localsearch*' 'usr/lib/systemd/user/localsearch*' 'usr/share/dbus-1/services/org.freedesktop.LocalSearch*' 'usr/share/dbus-1/services/org.freedesktop.Tracker3.Miner*' 'usr/share/dbus-1/services/org.freedesktop.Tracker3.Writeback*'"#
  }

- name="enable-paccache" default-value=#true {
    arch-packages "pacman-contrib"
    chroot-script "systemctl enable paccache.timer"
  }

- name="flatpak" default-value=#true {
    // Ditana enables Flatpak support for software that meets these criteria:
    // (1) not available in the official Arch or Ditana repositories,
    // (2) a local AUR build would be resource-intensive or unreliable, and
    // (3) the application benefits from sandboxing.
    //
    // The flathub remote is registered in chroot-install.sh (not here) because
    // chroot-script entries are executed in undefined order, but the remote
    // must exist before the sideload-repo symlink is registered. The actual
    // application deployment happens at first boot via the
    // ditana-flatpak-finalize.service systemd unit.
    arch-packages "flatpak"
    \ // Every Flatpak, not only the browsers, runs bwrap to build its outer
    \ // sandbox, and bwrap needs a user namespace. This is the declaration that
    \ // buys it one: Ditana keeps unprivileged user namespaces shut for
    \ // everything else, and each program that needs one asks here, beside the
    \ // package it belongs to.
    userns-allow "/usr/bin/bwrap"
    files "/etc/systemd/system/ditana-flatpak-finalize.service" \
          "/etc/systemd/system/greetd.service.d/wait-for-flatpaks.conf" \
          "/usr/lib/ditana/flatpak-finalize" \
          "/usr/lib/ditana/flatpak-show-progress"
    chroot-script "systemctl enable ditana-flatpak-finalize.service"
  }

- name="ditana-mirrorlist" default-value="`release-version`" {
    arch-packages "ditana-mirrorlist"
  }

- name="ditana-testing-mirrorlist" default-value="`NOT release-version`" {
    arch-packages "ditana-testing-mirrorlist"
  }
