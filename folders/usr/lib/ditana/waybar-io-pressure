# Shows the system's I/O pressure within a custom waybar module. It outputs a
# single line of JSON: the text represents the share of the last ten seconds
# during which at least one task was delayed due to I/O ("some avg10" from the
# kernel's pressure stall information), the tooltip shows all six averages, and
# the class applies tints to the module starting from WARM in five stages
# (warm-1 through warm-5) and shifts to red once the value reaches HOT (hot).
#
# A busy disk by itself conveys minimal insight: what truly hinders desktop
# performance is a task that must wait for it. Pressure stall information
# quantifies precisely this delay, and in contrast to the iowait share of CPU
# time, it remains visible even when processors are engaged in other work.
#
# The kernel outputs every average with precision to two decimal places; the
# text rounds it half up to a whole percent by handling the digits as textual
# characters, and the thresholds are evaluated against this rounded value. No
# operations involving floating point numbers occur, thus the locale has no
# influence on the result. The script nevertheless runs in the C locale: in a
# German locale, the regular expression range [0-9] also matches symbols like ²
# or ½, which the subsequent arithmetic then discards, so that a threshold
# specified in such a manner would be silently ignored rather than triggering a
# usage error.
#
# The file is read once per invocation: every access prompts the kernel to
# gather the stall durations for each CPU, and a single access ensures that
# "some" and "full" remain synchronized.
#
# waybar hides the module if no output is printed or the exit status differs
# from 0, and keeps its prior appearance when the line fails to constitute valid
# JSON. A kernel lacking pressure stall information (CONFIG_PSI=n, or psi=0 on
# the command line) does not provide such a file; in this case, just as with a
# file that cannot be read or does not conform to the expected structure, no
# content is printed.
#
# DITANA_PROC_ROOT is placed at the beginning of the path beneath /proc,
# enabling tests to direct the script toward a file of their choosing.

set -u
export LC_ALL=C

usage() {
    printf 'usage: %s [--warm PERCENT] [--hot PERCENT]\n' "${0##*/}" >&2
    exit 2
}

warm=20
hot=50
while (( $# )); do
    if (( $# < 2 )) || [[ ! $2 =~ ^[0-9]{1,3}$ ]]; then
        usage
    fi
    case $1 in
        --warm) warm=$((10#$2)) ;;
        --hot) hot=$((10#$2)) ;;
        *) usage ;;
    esac
    shift 2
done
(( warm < hot )) || usage

lines=()
mapfile -t lines 2>/dev/null < "${DITANA_PROC_ROOT-}/proc/pressure/io" || exit 0

average='([0-9]{1,3})\.([0-9]{2})'
format="^(some|full) avg10=$average avg60=$average avg300=$average total=[0-9]+\$"
some=
full=
for line in "${lines[@]}"; do
    [[ $line =~ $format ]] || continue
    row="${BASH_REMATCH[2]}.${BASH_REMATCH[3]} %  ${BASH_REMATCH[4]}.${BASH_REMATCH[5]} %  ${BASH_REMATCH[6]}.${BASH_REMATCH[7]} %"
    if [[ ${BASH_REMATCH[1]} == some ]]; then
        some=$row
        percent=$(( 10#${BASH_REMATCH[2]} + (10#${BASH_REMATCH[3]} >= 50) ))
    else
        full=$row
    fi
done
[[ -n $some && -n $full ]] || exit 0

if (( percent >= hot )); then
    class='["hot"]'
elif (( percent >= warm )); then
    step=$(( 1 + (percent - warm) * 5 / (hot - warm) ))
    class="[\"warm\",\"warm-$(( step < 5 ? step : 5 ))\"]"
else
    class='[]'
fi

lines=(
    "some  $some   (10 s / 60 s / 5 min)"
    "full  $full"
    "Shown: some over 10 s, the share of time in which at least one task waited for I/O"
    "full: the share of time in which all tasks that were not idle waited for I/O at once"
    "Source: pressure stall information (PSI) in /proc/pressure/io"
    "tint from $warm %, red from $hot %"
)
printf -v tooltip '%s\\n' "${lines[@]}"
printf '{"text":"%s%%","tooltip":"%s","class":%s}\n' "$percent" "${tooltip%\\n}" "$class"
