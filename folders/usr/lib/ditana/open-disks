# Shows the storage located at PATH. The disk module in waybar passes the path
# for which it shows available space, so this opens where that figure comes
# from.
#
# A filesystem residing on a block device opens in GNOME Disks. ZFS does not
# provide a block device: instead, the mount source is a dataset, and the free
# space displayed by waybar corresponds to the dataset's AVAIL, which may be
# influenced by quotas, reservations, and redundancy, and thus can differ from
# the pool's FREE. Consequently, a terminal presents the dataset before the
# pool. The classification depends on the filesystem type, not on the look of
# the source, ensuring that an overlay or tmpfs root is not taken for a pool.

set -u

if (( $# != 1 )); then
    printf 'usage: %s PATH\n' "${0##*/}" >&2
    exit 2
fi

fstype=$(findmnt -n -o FSTYPE -T "$1")
mount_source=$(findmnt -n -v -o SOURCE -T "$1")

if [[ $fstype == zfs ]]; then
    # The inner script takes dataset and pool as inputs, not as interpolated
    # values.
    # shellcheck disable=SC2016
    exec xdg-terminal-exec sh -c '
        echo "=== Dataset $1 (AVAIL is the free space shown in waybar) ==="
        zfs list -o name,used,avail,refer,mountpoint "$1"
        echo
        echo "=== Pool status ==="
        zpool status "$2"
        echo
        echo "=== Pool usage ==="
        zpool list "$2"
        echo
        echo "=== Datasets ==="
        zfs list -r "$2"
        echo
        printf "Press Enter to close. "
        read -r _
    ' sh "$mount_source" "${mount_source%%/*}"
fi

if [[ $mount_source == /dev/* ]]; then
    exec gnome-disks --block-device="$mount_source"
fi

exec gnome-disks
