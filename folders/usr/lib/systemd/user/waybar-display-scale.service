[Unit]
Description=Adjust Waybar config to physical display size and restart on hotplug
Documentation=file:/usr/lib/ditana/waybar-display-scale
After=graphical-session.target wayland-display-info.service
Wants=wayland-display-info.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/lib/ditana/waybar-display-scale
# `pkill waybar` also matches this script (its process name is
# "waybar-display-"), and since systemd counts SIGTERM as a clean exit,
# the scaling will remain disabled until the next login when using
# on-failure.
Restart=always
RestartSec=3s

[Install]
WantedBy=graphical-session.target