// -*- mode: jsonc -*-
{
  "layer": "top",
  "position": "bottom",
  "height": 64,
  "spacing": 4,
  "modules-left": [
    "custom/start",
    "custom/file-manager",
    "custom/search",
    "custom/browser",
    "custom/terminal",
    "custom/arch-package-manager",
    "custom/flatpak-manager",
    "custom/resources",
    "custom/display-settings",
    "custom/settings"
  ],
  "modules-center": [
    "custom/workspaces",
    "wlr/taskbar"
  ],
  "modules-right": [
    "mpd",
    "idle_inhibitor",
    "power-profiles-daemon",
//    "custom/cpu-temp",
//    "custom/cpu-fan",
    "cpu",
    "memory",
    "disk",
    "custom/io-pressure",
    "backlight",
    "battery",
    "battery#bat2",
    "pulseaudio",
    "tray",
    "clock",
    "custom/shutdown"
  ],
  "custom/start": {
    "format": " ",
    "tooltip": true,
    "tooltip-format": "Start",
    "on-click": "/usr/lib/ditana/launch nwggrid -p",
    "on-click-right": "/usr/lib/ditana/launch nwggrid -f",
  },
  "custom/file-manager": {
    "format": " ",
    "tooltip": true,
    "tooltip-format": "File Manager",
    "on-click": "/usr/lib/ditana/launch xdg-open \"$HOME\"",
  },
  "custom/search": {
    "format": " ",
    "tooltip": true,
    "tooltip-format": "File Search",
    "on-click": "/usr/lib/ditana/launch fsearch"
  },
  "custom/browser": {
    "format": " ",
    "tooltip": true,
    "tooltip-format": "Web Browser",
    "on-click": "/usr/lib/ditana/launch sh -c 'gtk-launch $(xdg-settings get default-web-browser)'"
  },
  "custom/terminal": {
    "format": " ",
    "tooltip": true,
    "tooltip-format": "Terminal",
    "on-click": "/usr/lib/ditana/launch xdg-terminal-exec"
  },
  "custom/arch-package-manager": {
    "format": " ",
    "tooltip": true,
    "tooltip-format": "Arch Package Manager (Add/Remove Software)",
    "on-click": "/usr/lib/ditana/launch pachub"
  },
  "custom/flatpak-manager": {
    "format": " ",
    "tooltip": true,
    "tooltip-format": "Flatpak Manager (Add/Remove Software)",
    "on-click": "/usr/lib/ditana/launch bazaar"
  },
  "custom/resources": {
    "format": " ",
    "tooltip": true,
    "tooltip-format": "System Monitor",
    "on-click": "/usr/lib/ditana/launch resources"
  },
  "custom/display-settings": {
    "format": " ",
    "tooltip": true,
    "tooltip-format": "Display Settings",
    "on-click": "/usr/lib/ditana/launch sh -c 'case \"$XDG_CURRENT_DESKTOP\" in *[Ww]ayfire*) exec wdisplays ;; *) exec monique ;; esac'",
  },
  "custom/settings": {
    "format": " ",
    "tooltip": true,
    "tooltip-format": "Settings",
    "on-click": "/usr/lib/ditana/launch sh -c 'case \"$XDG_CURRENT_DESKTOP\" in *[Ww]ayfire*) exec wcm ;; *) exec niri-settings ;; esac'",
  },
  "custom/shutdown": {
    "format": " ",
    "tooltip": true,
    "tooltip-format": "System Actions &amp; Power Menu",
    "on-click": "/usr/lib/ditana/launch nwgbar",
  },
  // The module shows the active workspace of the bar's output as "3/7",
  // accompanied by its name if one is set; the tooltip enumerates, for each
  // output, the workspaces that either host windows or have a name
  // assigned, along with the active one, each accompanied by its associated
  // windows. A click triggers the dialog that names the focused workspace,
  // which matches the active workspace of this output: niri directs focus
  // to the output under the cursor for every click that does not hit a
  // window, before waybar starts the command. The module does not respond
  // to scrolling: with warp-mouse-to-focus, niri puts the pointer on the
  // newly focused window after every switch, so the subsequent mouse wheel
  // step lands within that window. Mod+mouse wheel and the keyboard
  // shortcuts perform workspace switching instead. Outside niri, the helper
  // hides the module.
  "custom/workspaces": {
    "exec": "/usr/lib/ditana/waybar-niri-workspaces",
    "return-type": "json",
    "restart-interval": 5,
    "on-click": "/usr/lib/ditana/launch /usr/lib/ditana/rename-niri-workspace",
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 64,
    "tooltip-format": "{name}",
    "on-click": "minimize-raise",
    "on-click-middle": "close",
  },
  "keyboard-state": {
    "numlock": true,
    "capslock": true,
    "format": "{name} {icon}",
    "format-icons": {
      "locked": "",
      "unlocked": "",
    },
  },
  "mpd": {
    "format": "{stateIcon} {consumeIcon}{randomIcon}{repeatIcon}{singleIcon}{artist} - {album} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S}) ⸨{songPosition}|{queueLength}⸩ {volume}% ",
    "format-disconnected": "Disconnected ",
    "format-stopped": "{consumeIcon}{randomIcon}{repeatIcon}{singleIcon}Stopped ",
    "unknown-tag": "N/A",
    "interval": 5,
    "consume-icons": {
      "on": " ",
    },
    "random-icons": {
      "off": "<span color=\"#f53c3c\"></span> ",
      "on": " ",
    },
    "repeat-icons": {
      "on": " ",
    },
    "single-icons": {
      "on": "1 ",
    },
    "state-icons": {
      "paused": "",
      "playing": "",
    },
    "tooltip-format": "MPD (connected)",
    "tooltip-format-disconnected": "MPD (disconnected)",
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": "",
    },
  },
  "tray": {
    "icon-size": 32,
    "spacing": 10,
    // "icons": {
    //   "blueman": "bluetooth",
    //   "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
    // }
  },
  "clock": {
    "format": "{:%A, %B %d, %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
  },
  "cpu": {
    "format": "{usage}% ",
    "on-click": "/usr/lib/ditana/launch resources --open-tab-id processes",
    "tooltip": false,
    "justify": "center",
  },
  "memory": {
    "format": "{avail}GiB\nRAM",
    "on-click": "/usr/lib/ditana/launch resources --open-tab-id memory",
    "justify": "center",
  },
  "disk": {
    "path": "/",
    "format": "{free}\ndisk space",
    "on-click": "/usr/lib/ditana/launch /usr/lib/ditana/open-disks /",
    "justify": "center",
  },
  // Pressure stall information for I/O: the share of the past ~10 seconds
  // during which at least one task was delayed waiting for I/O. Concealed
  // when the kernel does not supply PSI.
  "custom/io-pressure": {
    "exec-if": "test -x /usr/lib/ditana/waybar-io-pressure",
    "exec": "/usr/lib/ditana/waybar-io-pressure --warm 20 --hot 50",
    "return-type": "json",
    "interval": 2,
    "format": "{}\nIO wait",
    "escape": true,
    "justify": "center",
  },
  "temperature": {
    // "thermal-zone": 2,
    // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
    "critical-threshold": 80,
    // "format-critical": "{temperatureC}°C {icon}",
    "format": "{temperatureC}°C {icon}",
    "format-icons": [
      "",
      "",
      ""
    ],
  },
  "backlight": {
    // "device": "acpi_video1",
    "format": "{percent}% {icon}",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ],
  },
  "battery": {
    "states": {
      // "good": 95,
      "warning": 30,
      "critical": 15,
    },
    "format": "{capacity}% {icon}",
    "format-full": "{capacity}% {icon}",
    "format-charging": "{capacity}% ",
    "format-plugged": "{capacity}% ",
    "format-alt": "{time} {icon}",
    // "format-good": "", // An empty format will hide the module
    // "format-full": "",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
  },
  "battery#bat2": {
    "bat": "BAT2",
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": "",
    },
  },
  "network": {
    // "interface": "wlp2*", // (Optional) To force the use of this interface
    "format-wifi": "{essid} ({signalStrength}%) ",
    "format-ethernet": "{ipaddr}/{cidr} ",
    "tooltip-format": "{ifname} via {gwaddr} ",
    "format-linked": "{ifname} (No IP) ",
    "format-disconnected": "Disconnected ⚠",
    "format-alt": "{ifname}: {ipaddr}/{cidr}",
  },
  "pulseaudio": {
    // "scroll-step": 1, // %, can be a float
    "format": "{volume}% {icon} {format_source}",
    "format-bluetooth": "{volume}% {icon} {format_source}",
    "format-bluetooth-muted": " {icon} {format_source}",
    "format-muted": " {format_source}",
    "format-source": "{volume}% ",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ],
    },
    "on-click": "/usr/lib/ditana/launch pavucontrol",
  },
  "custom/media": {
    "format": "{icon} {text}",
    "return-type": "json",
    "max-length": 40,
    "format-icons": {
      "spotify": "",
      "default": "🎜",
    },
    "escape": true,
    "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null", // Script in resources folder
    // "exec": "$HOME/.config/waybar/mediaplayer.py --player spotify 2> /dev/null" // Filter player based on name
  },
  // "custom/cpu-temp": {
  //   "format": "{}",
  //   "exec": "sensors | awk '/Package id 0/ {print $4}'",
  //   "interval": 10,
  //   "tooltip": false,
  //   "justify": "center",
  // },
  // "custom/cpu-fan": {
  //   "format": "{}",
  //   "exec": "sensors | awk '/fan1:/ {print $2 \" \" $3}'",
  //   "interval": 10,
  //   "tooltip": false,
  //   "justify": "center",
  // },
}
