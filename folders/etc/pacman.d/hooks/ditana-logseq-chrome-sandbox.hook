# logseq-desktop-bin ships Chromium's sandbox helper without the setuid bit.
# Ditana refuses user namespaces to programs that have not declared a need for
# one, making the helper the sole method for Logseq to build its sandbox;
# without the bit, Logseq aborts upon initialization. Each package update
# resets the file to 0755, which is why this runs after every upgrade rather
# than once at installation.
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = opt/logseq-desktop/chrome-sandbox

[Action]
Description = Making the Chromium sandbox helper of Logseq setuid root...
When = PostTransaction
Exec = /usr/bin/chmod 4755 /opt/logseq-desktop/chrome-sandbox
